{
  "name": "claude-dashboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "start": "bun run scripts/start.ts",
    "serve": "bun run --cwd packages/server start",
    "service:install": "bun run scripts/service.ts install",
    "service:uninstall": "bun run scripts/service.ts uninstall",
    "test": "bun test",
    "typecheck": "bun run --filter='*' typecheck && tsc -p tsconfig.json"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
